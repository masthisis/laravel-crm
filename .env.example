APP_NAME="Laravel CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_VERSION=1.0.0

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=crm
DB_USERNAME=crm
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="crm@example.com"
MAIL_FROM_NAME="${APP_NAME}"

REDIS_HOST=redis
REDIS_PORT=6379

# ---- CRM settings ----
CRM_CURRENCY=USD
CRM_COMMISSION_ROUNDING=2
CRM_CAPTURE_THROTTLE=30

# ---- External lead database sync (optional) ----
# Point these at ANY other database that contains leads; the
# `crm:sync-external-leads` command pulls them in on a schedule.
EXTERNAL_SYNC_ENABLED=false
EXTERNAL_DB_DRIVER=pgsql
EXTERNAL_DB_HOST=127.0.0.1
EXTERNAL_DB_PORT=5432
EXTERNAL_DB_DATABASE=external_crm
EXTERNAL_DB_USERNAME=readonly
EXTERNAL_DB_PASSWORD=
EXTERNAL_SYNC_TABLE=external_leads
